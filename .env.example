# ClipGlass Environment Configuration

# Application
ENVIRONMENT=development
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limits
MAX_DURATION_SECONDS=10800  # 3 hours
MAX_FILE_SIZE_BYTES=2147483648  # 2 GB
FILE_TTL_SECONDS=900  # 15 minutes
MAX_CONCURRENT_JOBS=10
MAX_JOBS_PER_IP=5
RATE_LIMIT_INSPECT_PER_MINUTE=10
RATE_LIMIT_JOBS_PER_10_MINUTES=5

# Directories
TEMP_STORAGE_DIR=/tmp/clipglass_downloads

# Redis / Queue (Optional in dev: falls back to in-memory async queue if Redis is not configured)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Optional Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# Optional Proxies & Cookies for YouTube
YOUTUBE_PROXY=
YOUTUBE_COOKIES_FILE=

# Sentry
SENTRY_DSN=

