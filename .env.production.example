# ClipGlass Production Environment Configuration
ENVIRONMENT=production
PORT=8000
WORKERS=4

# Domain & CORS
DOMAIN=clipglass.yourdomain.com
ACME_EMAIL=admin@yourdomain.com
ALLOWED_ORIGINS=https://clipglass.yourdomain.com

# Media Limits
MAX_DURATION_SECONDS=10800  # 3 hours
MAX_FILE_SIZE_BYTES=2147483648  # 2 GB
FILE_TTL_SECONDS=900  # 15 minutes ephemeral cleanup

# Rate Limiting
MAX_CONCURRENT_JOBS=10
MAX_JOBS_PER_IP=5
RATE_LIMIT_INSPECT_PER_MINUTE=10
RATE_LIMIT_JOBS_PER_10_MINUTES=5

# Ephemeral Storage Directory
TEMP_STORAGE_DIR=/tmp/clipglass_downloads

# Optional Distributed Redis Queue
USE_REDIS=false
REDIS_URL=redis://redis:6379/0

# Auto Clip Pipeline Settings
CLIP_DURATION_CAP=3600
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional Cloudflare Turnstile Anti-Bot
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Optional YouTube Proxy
YOUTUBE_PROXY=
YOUTUBE_COOKIES_FILE=

# Optional Sentry Error Monitoring
SENTRY_DSN=
