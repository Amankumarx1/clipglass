# Dockerfile.api - ClipGlass FastAPI Backend
FROM python:3.13-slim-bookworm

# Install ffmpeg and system runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser

WORKDIR /app

# Install python dependencies
COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY apps/api/ .

# Prepare temp storage with proper permissions
RUN mkdir -p /tmp/clipglass_downloads && chown -R appuser:appuser /tmp/clipglass_downloads /app

USER appuser

EXPOSE 8000

ENV PYTHONPATH=/app
ENV TEMP_STORAGE_DIR=/tmp/clipglass_downloads
ENV ENVIRONMENT=production

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/healthz || exit 1

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${WORKERS:-2} --proxy-headers --forwarded-allow-ips '*'"]
